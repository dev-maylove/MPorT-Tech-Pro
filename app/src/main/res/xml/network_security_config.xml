<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      MPorT Tech Pro — network diagnostic tool.

      Cleartext (HTTP) is required because many regional Ookla-compatible
      speed-test servers only expose HTTP on :8080 and then redirect to HTTPS.
      Android blocks cleartext by default (API 28+); we opt in intentionally.

      HTTPS (Ookla CDN, API, etc.) uses the system trust store — no custom CAs.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Optional: pin future production API here if needed (see docs/CERT_PINNING.md) -->
    <!--
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.mandalanet.id</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    -->
</network-security-config>
