# Copy this file to keystore.properties (do NOT commit the real file)
# Used for local signed release builds.
#
# Option A – absolute path
# KEYSTORE_PATH=/home/you/keys/mport-release.keystore
#
# Option B – relative to project root
KEYSTORE_PATH=release.keystore

KEYSTORE_PASSWORD=your_store_password
KEY_ALIAS=your_key_alias
KEY_PASSWORD=your_key_password

# Alternative key names (also supported):
# storeFile=release.keystore
# storePassword=...
# keyAlias=...
# keyPassword=...
